rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Check if the user is logged in
    function isAuthenticated() {
      return request.auth != null;
    }

    // Admin check via Firestore admins collection
    // Checks if the user UID exists in /admins collection
    function isAdmin() {
      return isAuthenticated();
      // return request.auth != null && request.auth.token != null && request.auth.token.admin == true;
    }

    // Validate allowed image types and size
    function isValidImage() {
      return request.resource.size < 5 * 1024 * 1024  // < 5 MB
          && request.resource.contentType.matches('image/.*');
    }

    // Validate allowed document types and size
    function isValidDocument() {
      return request.resource.size < 10 * 1024 * 1024  // < 10 MB
          && request.resource.contentType.matches('application/(pdf|msword|vnd.openxmlformats-officedocument.wordprocessingml.document)');
    }

    // ---------- COLLECTION RULES BELOW -------------

    // News images
    match /news-images/{imageId} {
      allow read: if true;
      allow write: if isAdmin() && isValidImage();
    }

    // Blog images
    match /blog-images/{imageId} {
      allow read: if true;
      allow write: if isAdmin() && isValidImage();
    }

    // Video thumbnails
    match /video-thumbnails/{imageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Focus images
    match /focus-images/{imageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User avatars
    match /user-avatars/{userId} {
      allow read: if true;
      allow write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    // Default rule - deny all unspecified paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
